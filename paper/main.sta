\usepackage [T1]{fontenc}\usepackage {newtxtext,newtxmath}\usetikzlibrary {positioning,arrows.meta,calc}\definecolor {neural}{HTML}{2F6DB5}\definecolor {neuralbg}{HTML}{E8F0FA}\definecolor {logic}{HTML}{2E8B57}\definecolor {logicbg}{HTML}{E6F4EC}\definecolor {symb}{HTML}{D9822B}\definecolor {relneg}{HTML}{C0392B}\tikzset {tok/.style={draw=neural!80, fill=white, rounded corners=1.5pt, inner sep=1.6pt, font=\scriptsize ,minimum height=4mm, anchor=base},htok/.style={tok, fill=neural!12},stok/.style={tok, draw=black!25, text=black!45},aedge/.style={line width=#1, draw=logic},cedge/.style={line width=#1, draw=relneg},ledge/.style={line width=#1, draw=neural, densely dashed},rlab/.style={font=\tiny , fill=white, inner sep=0.6pt},bar/.style={draw=none},}\newcommand {\bars }[4]{\fill [logic] (#1-0.17,0.05) rectangle ++(0.15,{0.8*#2});\fill [relneg] (#1+0.02,0.05) rectangle ++(0.15,{0.8*#3});\node [font=\tiny , anchor=north] at (#1-0.095,0.03) {$s$};\node [font=\tiny , anchor=north] at (#1+0.095,0.03) {$c$};\node [font=\tiny , anchor=north] at (#1,-0.22) {$#2\,/\,#3$};\node [font=\tiny , anchor=north, text=black!60] at (#1,-0.47) {$\omega {=}#4$};}\providecommand {\Pcov }{P_{\mathrm {cov}}}\providecommand {\Pnc }{P_{\neg \mathrm {conf}}}\providecommand {\E }{\textsc {e}}\providecommand {\N }{\textsc {n}}\providecommand {\C }{\textsc {c}}
\endsubpreamble
