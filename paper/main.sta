\usepackage [T1]{fontenc}\usepackage {newtxtext,newtxmath}\usetikzlibrary {positioning,arrows.meta,calc}\definecolor {neural}{HTML}{2F6DB5}\definecolor {neuralbg}{HTML}{E8F0FA}\definecolor {symb}{HTML}{D9822B}\definecolor {symbbg}{HTML}{FCF0E3}\definecolor {logic}{HTML}{2E8B57}\definecolor {logicbg}{HTML}{E6F4EC}\definecolor {lossc}{HTML}{6B6B6B}\definecolor {relneg}{HTML}{C0392B}\tikzset {>={Stealth[length=2.2mm]},flow/.style={->, line width=0.7pt, draw=black!75},block/.style={draw, rounded corners=3pt, line width=0.8pt, inner sep=5pt},nblock/.style={block, draw=neural, fill=neuralbg},sblock/.style={block, draw=symb, fill=symbbg},lblock/.style={block, draw=logic, fill=logicbg},title/.style={font=\bfseries \small , anchor=south west, inner sep=1pt},tok/.style={draw=black!55, fill=white, rounded corners=1.5pt, inner sep=1.4pt, font=\scriptsize , minimum height=3.8mm},ptok/.style={tok, draw=neural!80},htok/.style={tok, draw=neural!80, fill=neural!12},stok/.style={tok, draw=black!25, text=black!45},nullnode/.style={draw=black!60, dashed, circle, inner sep=1pt, font=\scriptsize , minimum size=5.5mm, fill=white},edgepos/.style={line width=1.3pt, draw=logic},edgelearn/.style={line width=0.9pt, draw=neural, densely dashed},edgenull/.style={line width=0.9pt, draw=black!55, densely dotted},lab/.style={font=\tiny , fill=white, inner sep=0.8pt},eq/.style={font=\scriptsize , anchor=north west, align=left, inner sep=1pt},}
\endsubpreamble
